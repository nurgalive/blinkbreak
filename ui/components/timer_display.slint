// Minimal TimerDisplay component for BlinkBreak.
// Empty shell to keep headless UI tests stable.
export component TimerDisplayWindow inherits Window {
    in property <string> time: "00:00";
    in property <string> secondary-time: "00:00";
    in property <float> progress: 0.0;
    in property <int> short_break_count: 0;
    in property <int> long_break_count: 0;

    width: 160px;
    height: 160px;
}
