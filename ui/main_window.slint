// Main window for BlinkBreak application

import {
    VerticalBox,
    HorizontalBox,
    Button,
    ProgressIndicator,
} from "std-widgets.slint";

import { SettingsDialog } from "components/settings_dialog.slint";

component TimerDisplay inherits Rectangle {
    in property <int> short_break_count: 0;
    in property <int> long_break_count: 0;
    in property <int> short_skipped_count: 0;
    in property <int> long_skipped_count: 0;

    width: 160px;
    height: 160px;
    border-radius: self.width / 2;
    background: #ffffff;
    border-width: 2px;
    border-color: #e0e0e0;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: "Breaks";
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            color: #424242;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: "Short: " + root.short_break_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: #757575;
            }

            Text {
                text: "Long: " + root.long_break_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: #757575;
            }
        }

        Text {
            text: "Skipped";
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            color: #424242;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: "Short: " + root.short_skipped_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: #757575;
            }

            Text {
                text: "Long: " + root.long_skipped_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: #757575;
            }
        }
    }
}

export { SettingsDialog }

export component MainWindow inherits Window {
    title: "BlinkBreak";
    min-width: 300px;
    min-height: 200px;

    // Callbacks to C++
    callback start-clicked();
    callback pause-clicked();
    callback settings-clicked();

    // Properties bound from C++
    in property <string> time-until-short: "10:00";
    in property <string> time-until-long: "30:00";
    in property <string> tracked-time: "00:00";
    in property <string> status-text: "Ready";
    in property <float> short-progress: 0.0;
    in property <float> long-progress: 0.0;
    in property <int> short-break-count: 0;
    in property <int> long-break-count: 0;
    in property <int> short-skipped-count: 0;
    in property <int> long-skipped-count: 0;
    in property <bool> is-running: false;
    out property <string> start-button-label: root.is-running ? "Pause" : "Start";

    VerticalBox {
        alignment: center;
        padding: 20px;
        spacing: 15px;

        // Status
        Text {
            text: root.status-text;
            font-size: 14px;
            horizontal-alignment: center;
        }

        // Timer display (short break countdown)
        HorizontalBox {
            alignment: center;

            TimerDisplay {
                short_break_count: root.short-break-count;
                long_break_count: root.long-break-count;
                short_skipped_count: root.short-skipped-count;
                long_skipped_count: root.long-skipped-count;
            }
        }

        // Progress bars
        VerticalBox {
            width: 100%;
            spacing: 6px;

            Text {
                text: "Short break in: " + root.time-until-short;
                font-size: 10px;
                color: #666666;
                horizontal-alignment: left;
            }

            ProgressIndicator {
                width: 100%;
                height: 8px;
                progress: root.short-progress;
            }

            Text {
                text: "Long break in: " + root.time-until-long;
                font-size: 10px;
                color: #666666;
                horizontal-alignment: left;
            }

            ProgressIndicator {
                width: 100%;
                height: 8px;
                progress: root.long-progress;
            }

            Text {
                text: "Tracked time: " + root.tracked-time;
                font-size: 10px;
                color: #666666;
                horizontal-alignment: left;
            }
        }

        // Control buttons
        HorizontalBox {
            alignment: center;
            spacing: 10px;

            Button {
                text: root.start-button-label;
                clicked => {
                    if (root.is-running) {
                        root.pause-clicked();
                    } else {
                        root.start-clicked();
                    }
                }
            }

            Button {
                text: "Settings";
                clicked => {
                    root.settings-clicked();
                }
            }
        }
    }
}
