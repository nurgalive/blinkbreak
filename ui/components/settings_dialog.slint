// Settings dialog component for BlinkBreak.
// Exposes basic break timing fields (intervals and durations).

import {
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
    Palette,
    ScrollView,
    Switch,
} from "std-widgets.slint";

component NumberFieldRow inherits Rectangle {
    in property <string> label: "";
    in property <string> unit: "";
    in-out property <string> value: "";

    height: 32px;

    HorizontalBox {
        spacing: 8px;
        alignment: start;

        Text {
            text: root.label;
            width: 140px;
            vertical-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
        }

        LineEdit {
            width: 80px;
            text <=> root.value;
        }

        Text {
            text: root.unit;
            vertical-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
        }
    }
}

export component SettingsDialog inherits Window {
    title: "Settings";
    min-width: 360px;
    min-height: 380px;
    preferred-width: 360px;
    preferred-height: 380px;
    background: Palette.background;

    callback save-clicked();
    callback cancel-clicked();

    // Editable values as strings for easy binding to LineEdit.
    // Intervals are in minutes; durations are in seconds.
    in-out property <string> short-interval-minutes: "10";
    in-out property <string> short-duration-seconds: "20";
    in-out property <string> long-interval-minutes: "60";
    in-out property <string> long-duration-seconds: "300";
    in-out property <string> snooze-duration-minutes: "5";
    in-out property <bool> overlay-all-monitors: true;
    in-out property <bool> overlay-opaque: false;
    in-out property <bool> theme-follow-system: true;
    in-out property <bool> theme-dark-mode: false;

    // Notification settings
    in-out property <bool> notification-enabled: true;
    in-out property <string> notification-warning-seconds: "30";
    in-out property <bool> notification-respect-dnd: true;
    in-out property <bool> notification-respect-fullscreen: false;

    // Idle detection settings
    in-out property <bool> idle-enabled: true;
    in-out property <string> idle-threshold-minutes: "3";
    in-out property <bool> idle-pause-on-idle: true;
    in-out property <bool> idle-reset-on-idle: false;
    in-out property <bool> idle-show-timer: false;
    in-out property <string> validation-error: "";
    out property <bool> has-validation-error: root.validation-error != "";
    out property <bool> dark-mode-enabled: !root.theme-follow-system;
    private property <ColorScheme> active-color-scheme: root.theme-follow-system ? ColorScheme.unknown : (root.theme-dark-mode ? ColorScheme.dark : ColorScheme.light);

    in-out property <ColorScheme> palette-color-scheme <=> Palette.color-scheme;
    init => {
        root.palette-color-scheme = root.active-color-scheme;
    }
    changed active-color-scheme => {
        root.palette-color-scheme = root.active-color-scheme;
    }

    VerticalBox {
        padding: 16px;
        spacing: 14px;

        Text {
            text: "Settings";
            font-size: 18px;
            font-weight: 600;
            color: Palette.foreground;
        }

        ScrollView {
            VerticalBox {
                spacing: 14px;

                Text {
                    text: "Short Break";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Interval";
                    unit: "minutes";
                    value <=> root.short-interval-minutes;
                }

                NumberFieldRow {
                    label: "Duration";
                    unit: "seconds";
                    value <=> root.short-duration-seconds;
                }

                Text {
                    text: "Long Break";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Interval";
                    unit: "minutes";
                    value <=> root.long-interval-minutes;
                }

                NumberFieldRow {
                    label: "Duration";
                    unit: "seconds";
                    value <=> root.long-duration-seconds;
                }

                Text {
                    text: "Overlay";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Snooze";
                    unit: "minutes";
                    value <=> root.snooze-duration-minutes;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Display on all monitors";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.overlay-all-monitors;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Opaque overlay";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.overlay-opaque;
                    }
                }

                Text {
                    text: "Theme";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Follow system theme";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.theme-follow-system;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Dark theme";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.theme-dark-mode;
                        enabled: !root.theme-follow-system;
                    }
                }

                Text {
                    text: "Notifications";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Enable notifications";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.notification-enabled;
                    }
                }

                NumberFieldRow {
                    label: "Warning time";
                    unit: "seconds";
                    value <=> root.notification-warning-seconds;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Respect DND";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.notification-respect-dnd;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Respect full-screen apps";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.notification-respect-fullscreen;
                    }
                }

                Text {
                    text: "Idle Detection";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Enable idle detection";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-enabled;
                    }
                }

                NumberFieldRow {
                    label: "Idle threshold";
                    unit: "minutes";
                    value <=> root.idle-threshold-minutes;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Pause on idle";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-pause-on-idle;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Reset on idle";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-reset-on-idle;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Show idle timer";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-show-timer;
                    }
                }

                if root.validation-error != "": Text {
                    text: root.validation-error;
                    font-size: 12px;
                    color: #d32f2f;
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            alignment: end;

            Button {
                text: "Cancel";
                clicked => {
                    root.cancel-clicked();
                }
            }

            Button {
                text: "Save";
                clicked => {
                    root.save-clicked();
                }
            }
        }
    }
}
