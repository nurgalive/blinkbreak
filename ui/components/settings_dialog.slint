// Settings dialog component for BlinkBreak.
// Exposes basic break timing fields (intervals and durations).

import {
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
    Switch,
    ScrollView,
    Palette,
} from "std-widgets.slint";

component NumberFieldRow inherits Rectangle {
    in property <string> label: "";
    in property <string> unit: "";
    in-out property <string> value: "";
    height: 32px;
    HorizontalBox {
        spacing: 8px;
        alignment: start;
        Text {
            text: root.label;
            width: 140px;
            vertical-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
        }

        LineEdit {
            width: 80px;
            text <=> root.value;
        }

        Text {
            text: root.unit;
            vertical-alignment: center;
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.6);
        }
    }
}

export component SettingsDialog inherits Window {
    title: "Settings";
    min-width: 360px;
    min-height: 380px;
    preferred-width: 360px;
    preferred-height: 380px;
    background: Palette.background;
    callback save-clicked();
    callback cancel-clicked();

    // Editable values as strings for easy binding to LineEdit.
    // Intervals are in minutes; durations are in seconds.
    in-out property <string> short-interval-minutes: "10";
    in-out property <string> short-duration-seconds: "20";
    in-out property <string> long-interval-minutes: "60";
    in-out property <string> long-duration-seconds: "300";
    in-out property <string> snooze-duration-minutes: "5";
    in-out property <bool> overlay-all-monitors: true;
    in-out property <bool> overlay-opaque: false;

    // Idle detection settings
    in-out property <bool> idle-enabled: true;
    in-out property <string> idle-threshold-minutes: "3";
    in-out property <bool> idle-pause-on-idle: true;
    in-out property <bool> idle-reset-on-idle: false;
    in-out property <bool> idle-show-timer: false;
    in-out property <string> validation-error: "";
    out property <bool> has-validation-error: root.validation-error != "";

    // Appearance / theme settings
    in-out property <bool> theme-auto: true;   // follow OS
    in-out property <bool> theme-dark: false;  // forced dark (only used when theme-auto is false)

    // Each top-level Slint component owns its own SharedGlobals/FluentPalette.
    // C++ must set this on the dialog too to keep its palette in sync with MainWindow.
    // 0 = auto (follow OS), 1 = light, 2 = dark.
    in property <int> color-scheme-index: 0;
    changed color-scheme-index => {
        Palette.color-scheme = root.color-scheme-index == 1 ? ColorScheme.light : root.color-scheme-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    VerticalBox {
        padding: 16px;
        spacing: 14px;
        Text {
            text: "Settings";
            font-size: 18px;
            font-weight: 600;
        }

        ScrollView {
            VerticalBox {
                spacing: 14px;

        // Appearance section (first, so users see it right away)
        Text {
                    text: "Appearance";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Follow system theme";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.theme-auto;
                    }
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Dark mode";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: root.theme-auto ? Palette.foreground.with-alpha(0.4) : Palette.foreground;
                    }

                    Switch {
                        enabled: !root.theme-auto;
                        checked <=> root.theme-dark;
                    }
                }

        // Short break section
        Text {
                    text: "Short Break";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Interval";
                    unit: "minutes";
                    value <=> root.short-interval-minutes;
                }

                NumberFieldRow {
                    label: "Duration";
                    unit: "seconds";
                    value <=> root.short-duration-seconds;
                }

        // Long break section
        Text {
                    text: "Long Break";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Interval";
                    unit: "minutes";
                    value <=> root.long-interval-minutes;
                }

                NumberFieldRow {
                    label: "Duration";
                    unit: "seconds";
                    value <=> root.long-duration-seconds;
                }

        // Overlay section
        Text {
                    text: "Overlay";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Snooze";
                    unit: "minutes";
                    value <=> root.snooze-duration-minutes;
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Display on all monitors";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.overlay-all-monitors;
                    }
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Opaque overlay";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.overlay-opaque;
                    }
                }

        // Idle detection section
        Text {
                    text: "Idle Detection";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Enable idle detection";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-enabled;
                    }
                }

                NumberFieldRow {
                    label: "Idle threshold";
                    unit: "minutes";
                    value <=> root.idle-threshold-minutes;
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Pause on idle";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-pause-on-idle;
                    }
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Reset on idle";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-reset-on-idle;
                    }
                }

                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Show idle timer";
                        width: 140px;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-show-timer;
                    }
                }

                if root.validation-error != "": Text {
                    text: root.validation-error;
                    font-size: 12px;
                    color: #d32f2f;
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            alignment: end;
            Button {
                text: "Cancel";
                clicked => {
                    root.cancel-clicked();
                }
            }

            Button {
                text: "Save";
                clicked => {
                    root.save-clicked();
                }
            }
        }
    }
}
