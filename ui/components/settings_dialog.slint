// Embedded settings view for BlinkBreak.

import {
    VerticalBox,
    HorizontalBox,
    LineEdit,
    Palette,
    ScrollView,
    Switch,
} from "std-widgets.slint";

import { Fonts } from "typography.slint";

component NumberFieldRow inherits Rectangle {
    in property <string> label: "";
    in property <string> unit: "";
    in-out property <string> value: "";
    in property <string> error: "";

    height: root.error != "" ? 52px : 32px;

    VerticalBox {
        padding: 0;
        spacing: 4px;
        alignment: start;

        HorizontalBox {
            padding: 0;
            spacing: 8px;
            alignment: start;
            height: 32px;

            Text {
                text: root.label;
                width: 280px;
                vertical-alignment: center;
                font-size: Fonts.body;
                color: Palette.foreground;
            }

            LineEdit {
                width: 80px;
                text <=> root.value;
            }

            Text {
                text: root.unit;
                vertical-alignment: center;
                font-size: Fonts.body;
                color: Palette.foreground;
            }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Fonts.body;
            color: #d32f2f;
        }
    }
}

export component SettingsView inherits Rectangle {
    background: Palette.background;

    callback settings-changed();

    in-out property <string> short-interval-minutes: "10";
    in-out property <string> short-duration-seconds: "20";
    in-out property <string> long-interval-minutes: "60";
    in-out property <string> long-duration-seconds: "300";
    in-out property <string> snooze-duration-minutes: "5";
    in-out property <bool> overlay-all-monitors: true;
    in-out property <bool> overlay-opaque: false;
    in-out property <bool> theme-follow-system: true;
    in-out property <bool> theme-dark-mode: false;

    in-out property <bool> notification-enabled: true;
    in-out property <string> notification-warning-seconds: "30";
    in-out property <bool> notification-respect-dnd: true;
    in-out property <bool> notification-respect-fullscreen: false;

    in-out property <bool> idle-enabled: true;
    in-out property <string> idle-threshold-minutes: "3";
    in-out property <bool> idle-pause-on-idle: true;
    in-out property <bool> idle-show-timer: false;
    in-out property <bool> idle-reset-short-on-idle: true;
    in-out property <string> idle-reset-short-threshold-minutes: "20";
    in-out property <bool> idle-reset-long-on-idle: true;
    in-out property <string> idle-reset-long-threshold-minutes: "20";

    in-out property <string> short-interval-error: "";
    in-out property <string> short-duration-error: "";
    in-out property <string> long-interval-error: "";
    in-out property <string> long-duration-error: "";
    in-out property <string> snooze-duration-error: "";
    in-out property <string> notification-warning-error: "";
    in-out property <string> idle-threshold-error: "";
    in-out property <string> idle-reset-short-error: "";
    in-out property <string> idle-reset-long-error: "";
    in-out property <string> validation-error: "";

    out property <bool> has-validation-error: root.validation-error != "";
    out property <bool> dark-mode-enabled: !root.theme-follow-system;
    private property <ColorScheme> active-color-scheme: root.theme-follow-system ? ColorScheme.unknown : (root.theme-dark-mode ? ColorScheme.dark : ColorScheme.light);

    in-out property <ColorScheme> palette-color-scheme <=> Palette.color-scheme;
    init => {
        root.palette-color-scheme = root.active-color-scheme;
    }
    changed active-color-scheme => {
        root.palette-color-scheme = root.active-color-scheme;
    }

    VerticalBox {
        padding: 16px;
        spacing: 14px;

        Text {
            text: "Settings";
            font-size: Fonts.title;
            font-weight: Fonts.title-weight;
            color: Palette.foreground;
        }

        ScrollView {
            VerticalBox {
                spacing: 14px;

                Text {
                    text: "Short Break";
                    font-size: Fonts.header;
                    font-weight: Fonts.header-weight;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Interval";
                    unit: "minutes";
                    value <=> root.short-interval-minutes;
                    error: root.short-interval-error;
                }

                NumberFieldRow {
                    label: "Duration";
                    unit: "seconds";
                    value <=> root.short-duration-seconds;
                    error: root.short-duration-error;
                }

                Text {
                    text: "Long Break";
                    font-size: Fonts.header;
                    font-weight: Fonts.header-weight;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Interval";
                    unit: "minutes";
                    value <=> root.long-interval-minutes;
                    error: root.long-interval-error;
                }

                NumberFieldRow {
                    label: "Duration";
                    unit: "seconds";
                    value <=> root.long-duration-seconds;
                    error: root.long-duration-error;
                }

                Text {
                    text: "Overlay";
                    font-size: Fonts.header;
                    font-weight: Fonts.header-weight;
                    color: Palette.foreground;
                }

                NumberFieldRow {
                    label: "Snooze";
                    unit: "minutes";
                    value <=> root.snooze-duration-minutes;
                    error: root.snooze-duration-error;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Display on all monitors";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.overlay-all-monitors;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Opaque overlay";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.overlay-opaque;
                    }
                }

                Text {
                    text: "Theme";
                    font-size: Fonts.header;
                    font-weight: Fonts.header-weight;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Follow system theme";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.theme-follow-system;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Dark theme";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.theme-dark-mode;
                        enabled: !root.theme-follow-system;
                    }
                }

                Text {
                    text: "Notifications";
                    font-size: Fonts.header;
                    font-weight: Fonts.header-weight;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Enable notifications";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.notification-enabled;
                    }
                }

                NumberFieldRow {
                    label: "Warning time";
                    unit: "seconds";
                    value <=> root.notification-warning-seconds;
                    error: root.notification-warning-error;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Respect DND";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.notification-respect-dnd;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Respect full-screen apps";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.notification-respect-fullscreen;
                    }
                }

                Text {
                    text: "Idle Detection";
                    font-size: Fonts.header;
                    font-weight: Fonts.header-weight;
                    color: Palette.foreground;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Enable idle detection";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-enabled;
                    }
                }

                NumberFieldRow {
                    label: "Idle threshold";
                    unit: "minutes";
                    value <=> root.idle-threshold-minutes;
                    error: root.idle-threshold-error;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Pause on idle";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-pause-on-idle;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Show idle timer";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-show-timer;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Reset short break on idle";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-reset-short-on-idle;
                    }
                }

                NumberFieldRow {
                    label: "Reset short break on idle threshold";
                    unit: "minutes";
                    value <=> root.idle-reset-short-threshold-minutes;
                    error: root.idle-reset-short-error;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Reset long break on idle";
                        width: 280px;
                        vertical-alignment: center;
                        font-size: Fonts.body;
                        color: Palette.foreground;
                    }

                    Switch {
                        checked <=> root.idle-reset-long-on-idle;
                    }
                }

                NumberFieldRow {
                    label: "Reset long break on idle threshold";
                    unit: "minutes";
                    value <=> root.idle-reset-long-threshold-minutes;
                    error: root.idle-reset-long-error;
                }

                if root.validation-error != "": Text {
                    text: root.validation-error;
                    font-size: Fonts.body;
                    color: #d32f2f;
                }
            }
        }
    }
}
