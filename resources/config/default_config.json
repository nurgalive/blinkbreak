{
  "short_break": {
    "enabled": true,
    "interval_seconds": 600,
    "duration_seconds": 20,
    "messages": [
      "Look away from the screen",
      "Focus on something 20 feet away",
      "Blink slowly 10 times",
      "Close your eyes and relax"
    ],
    "rotate_messages": true
  },
  "long_break": {
    "enabled": true,
    "interval_seconds": 3600,
    "duration_seconds": 300,
    "messages": [
      "Time for a longer break!",
      "Stand up and stretch",
      "Take a short walk",
      "Hydrate yourself"
    ],
    "rotate_messages": true
  },
  "idle": {
    "enabled": true,
    "threshold_seconds": 180,
    "pause_on_idle": true,
    "reset_short_on_idle": true,
    "reset_short_threshold_seconds": 1200,
    "reset_long_on_idle": true,
    "reset_long_threshold_seconds": 1200
  },
  "notification": {
    "enabled": true,
    "warning_seconds": 30,
    "respect_dnd": true,
    "respect_fullscreen": false
  },
  "theme": {
    "follow_system": true,
    "dark_mode": false
  },
  "overlay": {
    "opacity": 0.7,
    "show_on_all_monitors": true,
    "allow_skip": true,
    "allow_snooze": true,
    "snooze_duration_seconds": 300
  },
  "start_minimized": false,
  "auto_start": false
}
