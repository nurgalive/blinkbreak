// Main window for BlinkBreak application

import {
    VerticalBox,
    HorizontalBox,
    Button,
    ProgressIndicator,
    Palette,
} from "std-widgets.slint";

import { SettingsDialog } from "components/settings_dialog.slint";

component TimerDisplay inherits Rectangle {
    in property <int> short_break_count: 0;
    in property <int> long_break_count: 0;
    in property <int> short_skipped_count: 0;
    in property <int> long_skipped_count: 0;
    in property <string> tracked_time: "00:00";
    width: 160px;
    height: 160px;
    border-radius: self.width / 2;
    background: Palette.background;
    border-width: 2px;
    border-color: Palette.border;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.tracked_time;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
            color: #2196f3;
        }

        Text {
            text: "Breaks";
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            color: Palette.foreground;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: "Short: " + root.short_break_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: Palette.foreground.with-alpha(0.6);
            }

            Text {
                text: "Long: " + root.long_break_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: Palette.foreground.with-alpha(0.6);
            }
        }

        Text {
            text: "Skipped";
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            color: Palette.foreground;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: "Short: " + root.short_skipped_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: Palette.foreground.with-alpha(0.6);
            }

            Text {
                text: "Long: " + root.long_skipped_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: Palette.foreground.with-alpha(0.6);
            }
        }
    }
}

export { SettingsDialog }

export component MainWindow inherits Window {
    title: "BlinkBreak";
    icon: @image-url("../resources/bb_logo_blue.ico");
    min-width: 320px;
    min-height: 420px;
    preferred-width: 340px;
    preferred-height: 440px;
    background: Palette.background;

    // Callbacks to C++
    callback start-clicked();
    callback pause-clicked();
    callback settings-clicked();

    // Properties bound from C++
    in property <string> time-until-short: "10:00";
    in property <string> time-until-long: "30:00";
    in property <string> tracked-time: "00:00";
    in property <string> status-text: "Ready";
    in property <float> short-progress: 0.0;
    in property <float> long-progress: 0.0;
    in property <int> short-break-count: 0;
    in property <int> long-break-count: 0;
    in property <int> short-skipped-count: 0;
    in property <int> long-skipped-count: 0;
    in property <bool> is-running: false;
    in property <bool> show-idle-timer: false;
    in property <string> idle-time: "00:00";
    // 0 = auto (follow OS), 1 = light, 2 = dark
    in property <int> color-scheme-index: 0;
    // React to theme changes set by C++ and push into Palette.
    changed color-scheme-index => {
        Palette.color-scheme = root.color-scheme-index == 1 ? ColorScheme.light : root.color-scheme-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    out property <string> start-button-label: root.is-running ? "Pause" : "Start";
    VerticalBox {
        alignment: center;
        padding: 20px;
        spacing: 15px;

        // Status
        Text {
            text: root.status-text;
            font-size: 14px;
            horizontal-alignment: center;
        }

        // Timer display (short break countdown)
        HorizontalBox {
            alignment: center;
            TimerDisplay {
                tracked_time: root.tracked-time;
                short_break_count: root.short-break-count;
                long_break_count: root.long-break-count;
                short_skipped_count: root.short-skipped-count;
                long_skipped_count: root.long-skipped-count;
            }
        }

        // Progress bars
        VerticalBox {
            width: 100%;
            spacing: 6px;
            Text {
                text: "Short break in: " + root.time-until-short;
                font-size: 10px;
                color: Palette.foreground.with-alpha(0.6);
                horizontal-alignment: left;
            }

            ProgressIndicator {
                width: 100%;
                height: 8px;
                progress: root.short-progress;
            }

            Text {
                text: "Long break in: " + root.time-until-long;
                font-size: 10px;
                color: Palette.foreground.with-alpha(0.6);
                horizontal-alignment: left;
            }

            ProgressIndicator {
                width: 100%;
                height: 8px;
                progress: root.long-progress;
            }

            if (root.show-idle-timer): Text {
                text: "Idle time: " + root.idle-time;
                font-size: 10px;
                color: Palette.foreground.with-alpha(0.6);
                horizontal-alignment: left;
            }
        }

        // Control buttons
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            Button {
                text: root.start-button-label;
                clicked => {
                    if (root.is-running) {
                        root.pause-clicked();
                    } else {
                        root.start-clicked();
                    }
                }
            }

            Button {
                text: "Settings";
                clicked => {
                    root.settings-clicked();
                }
            }
        }
    }
}
