// Minimal TimerDisplay component for BlinkBreak.
//
// Replaced the more complex approximation with a compact, well-formed component
// to avoid Slint parsing/syntax issues while keeping the visual timer.
component TimerDisplay inherits Rectangle {
    in property <string> time: "00:00";
    in property <string> secondary-time: "00:00";
    in property <float> progress: 0.0; // kept for future use
    in property <int> short_break_count: 0;
    in property <int> long_break_count: 0;

    // Default size; parent can override
    width: 160px;
    height: 160px;
    border-radius: self.width / 2;
    background: #ffffff;
    border-width: 2px;
    border-color: #e0e0e0;

    // Centered time text
    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: "Breaks";
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            color: #424242;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: "Short: " + root.short_break_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: #757575;
            }

            Text {
                text: "Long: " + root.long_break_count;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                color: #757575;
            }
        }
    }
}
